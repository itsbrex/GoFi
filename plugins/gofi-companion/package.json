{
  "name": "gofi-companion",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "allowScripts": {
    "isolated-vm@6.0.2": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:packages": "node scripts/smoke-packages.mjs",
    "validate": "node scripts/validate.mjs",
    "pack:all": "node scripts/package.mjs"
  },
  "dependencies": {
    "@utcp/code-mode": "1.2.13",
    "@utcp/sdk": "1.2.0",
    "@utcp/cli": "1.1.3",
    "@utcp/mcp": "1.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "isolated-vm": "6.0.2",
    "ajv": "8.20.0"
  }
}
