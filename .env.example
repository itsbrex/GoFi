# Spotify API credentials
# Create an application at https://developer.spotify.com/dashboard
# Set the redirect URI to http://localhost:8888/callback in your application settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer authentication
# Your ARL token in the cookies after logging into Deezer in your browser
DEEZER_ARL=

# GoFi download defaults
# Command-line flags still take precedence over these values.
GOFI_OUTPUT_DIR=./downloads
GOFI_TRACK_OUTPUT_DIR=./downloads/Tracks
GOFI_ALBUM_OUTPUT_DIR=./downloads/Albums
GOFI_PLAYLIST_OUTPUT_DIR=./downloads/Playlists
GOFI_QUALITY=9
GOFI_CONCURRENCY=5
GOFI_LOG_LEVEL=info

# Duplicate handling
# When enabled, GoFi recursively searches the configured output folders for an
# existing matching track file and creates a symlink instead of re-downloading.
GOFI_SYMLINK_EXISTING_TRACKS=0
# Optional extra search roots, separated by comma, colon, or new line.
GOFI_SYMLINK_SEARCH_DIRS=
